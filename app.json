{
  "expo": {
    "name": "Body Batteries",
    "slug": "my-body-batteries-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0d0d1a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bellybuilder.bodybatteries",
      "infoPlist": {
        "NSHealthShareUsageDescription": "BodyBatteries reads your daily burned calories from Apple Health to show your energy balance."
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/b94421af-d4b8-4756-971e-c81130bd7c90"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d1a"
      },
      "package": "com.bellybuilder.bodybatteries",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0d0d1a"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "react-native-health",
        {
          "healthSharePermission": "BodyBatteries reads your daily burned calories from Apple Health to show your energy balance."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b94421af-d4b8-4756-971e-c81130bd7c90"
      }
    },
    "owner": "bodybuilder007"
  }
}
